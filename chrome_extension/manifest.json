{
  "manifest_version": 3,
  "name": "ComfyWorkflows Downloader",
  "version": "1.0.0",
  "description": "Download ComfyUI workflows from ComfyWorkflows.com with one click",
  "permissions": [
    "activeTab",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://comfyworkflows.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://comfyworkflows.com/workflow/*", "https://comfyworkflows.com/workflows/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
